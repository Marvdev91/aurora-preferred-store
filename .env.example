# Copy to .env and fill in. .env is gitignored.
# Private key: Klaviyo > Settings > API keys. Scopes needed:
#   Profiles (write), Events (write), Segments (write), Accounts (read), Lists (read)
KLAVIYO_PRIVATE_API_KEY=pk_replace_me

# Public account/site ID — safe to share, this is what the panel references.
KLAVIYO_PUBLIC_API_KEY=replace_me

# API revision is pinned in src/config.py; override here only deliberately.
# KLAVIYO_REVISION=2025-01-15
